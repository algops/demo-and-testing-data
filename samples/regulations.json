  {
    "regulation": "GDPR Compliance Requirements",
    "data": {
      "type": "Data Protection",
      "title": "GDPR Compliance Requirements",
      "regulationId": "REG-GDPR-001",
      "complianceLevel": "mandatory",
      "structuredRules": {
        "requirements": [
          {
            "requirement": "Data minimization",
            "description": "Collect only necessary personal data"
          },
          {
            "requirement": "Right to access",
            "description": "Users must be able to access their data"
          },
          {
            "requirement": "Right to deletion",
            "description": "Users must be able to request data deletion"
          }
        ],
        "penalties": {
          "non_compliance": "Up to 4% of annual revenue or €20M"
        }
      },
      "applicableRegions": ["EU", "EEA"],
      "effectiveDate": "2018-05-25",
      "lastUpdated": "2025-01-15T10:00:00Z",
      "tags": ["gdpr", "data-protection", "privacy", "compliance"]
    }
  },
  {
