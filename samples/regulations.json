      "title": "PCI DSS Requirements",
      "regulationId": "REG-PCIDSS-001",
      "complianceLevel": "mandatory",
      "structuredRules": {
        "requirements": [
          {
            "requirement": "Build and maintain secure network",
            "controls": ["Firewall configuration", "Default passwords"]
          },
          {
            "requirement": "Protect cardholder data",
            "controls": ["Data encryption", "Data retention policies"]
          },
          {
            "requirement": "Maintain vulnerability management",
            "controls": ["Antivirus software", "Secure systems"]
          }
        ],
        "validationLevels": {
          "level1": "Annual on-site audit",
          "level2-4": "Self-assessment questionnaire"
        }
      },
      "applicableRegions": ["Global"],
      "effectiveDate": "2024-03-31",
