{
  "id": "src-etl-documents-api",
  "name": "ETL Documents API",
  "description": "API for accessing quality rule documents from ETL pipeline, providing structured quality guidelines and compliance rules",
  "source_type": "Integration",
  "delivery_type": "Endpoint",
  "configuration": {
    "max_concurrent_runs": 20,
    "timeout": 100,
    "max_retries": 2,
    "auth_key": null
  },
  "templates": {
    "run_request_template": "{\"url\": \"https://etl-docs.internal/api/v1/documents\", \"method\": \"GET\", \"headers\": {\"Content-Type\": \"application/json\", \"X-API-Key\": \"<<$auth_key>>\"}, \"body\": {\"category\": \"quality_rules\", \"filters\": \"<<$run_setup>>\", \"limit\": \"<<$max_objects>>\"}}",
    "status_request_template": "{}",
    "delivery_request_template": "{}"
  },
  "setup": {
    "run_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_setup": { "path": ["body", "filters"], "status": "mapped" },
          "webhook_url": { "path": ["webhook_url"], "status": "remaining" },
          "run_id": { "path": ["id"], "status": "issue" }
        },
        "response": {
          "status": {
            "path": ["status"],
            "status": "recommended",
            "status_translations": { "ready": "completed", "processing": "running", "failed": "error" }
          },
          "query_id": {
            "path": ["query_id"],
            "status": "mapped"
          }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://etl-docs.internal/api/v1/documents\", \"method\": \"GET\", \"headers\": {\"Content-Type\": \"application/json\", \"X-API-Key\": \"<<$auth_key>>\"}, \"body\": {\"category\": \"quality_rules\", \"filters\": \"<<$run_setup>>\", \"limit\": \"<<$max_objects>>\"}}"
    },
    "status_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "status": { "path": ["status"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://etl-docs.internal/api/v1/queries/<<$run_external_id>>/status\", \"method\": \"GET\", \"headers\": {\"X-API-Key\": \"<<$auth_key>>\"}, \"body\": {}}"
    },
    "delivery_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "data": { "path": ["documents"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://etl-docs.internal/api/v1/queries/<<$run_external_id>>/results\", \"method\": \"GET\", \"headers\": {\"X-API-Key\": \"<<$auth_key>>\"}, \"body\": {}}"
    }
  },
