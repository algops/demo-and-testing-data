{
  "id": "src-etl-pipeline",
  "name": "ETL Pipeline",
  "description": "Extract, Transform, Load pipeline for extracting person and contact information from various data sources",
  "source_type": "Integration",
  "delivery_type": "Endpoint",
  "configuration": {
    "max_concurrent_runs": 30,
    "timeout": 120,
    "max_retries": 2,
    "auth_key": null
  },
  "templates": {
    "run_request_template": "{\"url\": \"https://etl-pipeline.internal/api/v1/extract\", \"method\": \"POST\", \"headers\": {\"Content-Type\": \"application/json\", \"X-API-Key\": \"<<$auth_key>>\"}, \"body\": {\"source\": \"supplier_contacts\", \"filters\": \"<<$run_setup>>\", \"max_results\": \"<<$max_objects>>\"}}",
    "status_request_template": "{}",
    "delivery_request_template": "{}"
  },
  "setup": {
    "run_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_setup": { "path": ["body", "filters"], "status": "mapped" },
          "webhook_url": { "path": ["webhook_url"], "status": "remaining" },
          "run_id": { "path": ["id"], "status": "issue" }
        },
        "response": {
          "status": {
            "path": ["status"],
            "status": "recommended",
            "status_translations": { "ready": "completed", "processing": "running", "failed": "error" }
          },
          "extraction_id": {
            "path": ["extraction_id"],
            "status": "mapped"
          }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://etl-pipeline.internal/api/v1/extract\", \"method\": \"POST\", \"headers\": {\"Content-Type\": \"application/json\", \"X-API-Key\": \"<<$auth_key>>\"}, \"body\": {\"source\": \"supplier_contacts\", \"filters\": \"<<$run_setup>>\", \"max_results\": \"<<$max_objects>>\"}}"
    },
    "status_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "status": { "path": ["status"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://etl-pipeline.internal/api/v1/extractions/<<$run_external_id>>/status\", \"method\": \"GET\", \"headers\": {\"X-API-Key\": \"<<$auth_key>>\"}, \"body\": {}}"
    },
    "delivery_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "data": { "path": ["contacts"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://etl-pipeline.internal/api/v1/extractions/<<$run_external_id>>/results\", \"method\": \"GET\", \"headers\": {\"X-API-Key\": \"<<$auth_key>>\"}, \"body\": {}}"
    }
  },
  "metadata": {
    "owner_org_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "owner_org_name": "AlgOps Data Solutions",
