{
  "id": "3190e39c-d9d7-4eeb-95af-8be16f877044",
  "name": "ESG Agent",
  "description": "Environmental, Social, and Governance document analysis agent for sustainability reporting and compliance assessment",
  "source_type": "Agent",
  "delivery_type": "Webhook",
  "setup": {
    "customization_permissions": {
      "factor_creation": "creator_only"
    },
    "load_balancing": {
      "concurrency": 10,
      "timeout": 30
    },
    "processing_options": {
      "input_processing": "ignore"
    },
    "run_request": {
      "mappings": {
        "request": {
          "run_setup": {
            "path": [
              "body",
              "companies"
            ],
            "mapping_status": "mapped"
          },
          "webhook_url": {
            "path": [
              "body",
              "webhook_url"
            ],
            "mapping_status": "mapped"
          },
          "run_id": {
            "path": [
              "body",
              "run_id"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "recommended",
            "status_translations": {
              "completed": "completed",
              "processing": "running",
              "failed": "error"
            }
          },
          "analysis_id": {
            "path": [
              "analysis_id"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://esg-agent.internal/api/analyze",
        "method": "POST",
        "headers": {
          "Content_Type": "application/json"
        },
        "body": {
          "companies": "<<$run_setup>>",
          "webhook_url": "<<$webhook_url>>",
          "run_id": "<<$id>>"
        }
      },
      "response_examples": [],
      "factor_variables": {
        "run_setup": {
          "path": [
            "body",
            "companies"
          ],
          "example_value": {
            "filters": {
              "industry": "Technology",
              "size": "medium"
            }
          }
        },
        "webhook_url": {
          "path": [
            "body",
            "webhook_url"
          ],
          "example_value": "https://example.com/webhook"
        },
        "run_id": {
          "path": [
            "body",
            "run_id"
          ],
          "example_value": "run-12345"
        }
      }
    },
    "status_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://esg-agent.internal/api/analyses/<<$run_external_id>>/status",
        "method": "GET",
        "headers": {
          "Content_Type": "application/json"
        },
        "body": {}
      },
      "response_examples": []
    },
    "delivery_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "data": {
            "path": [
              "esg_data"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://esg-agent.internal/api/analyses/<<$run_external_id>>/results",
        "method": "GET",
        "headers": {
          "Content_Type": "application/json"
        },
        "body": {}
      },
      "response_examples": [
        {
          "status": "completed",
          "analysis_id": "esg-analysis-22222",
          "esg_data": [
            {
              "company_id": "comp-001",
              "esg_score": 0.82,
              "compliance_status": "compliant",
              "rfi_sent_date": "2025-01-15T10:00:00.000Z",
              "last_compliance_check": "2025-01-20T16:30:45.000Z",
              "esg_breakdown": {
                "environmental": 0.85,
                "social": 0.8,
                "governance": 0.81
              },
              "compliance_issues": [],
              "certifications": [
                "ISO 14001",
                "B-Corp Certified"
              ]
            },
            {
              "company_id": "comp-002",
              "esg_score": 0.65,
              "compliance_status": "needs_improvement",
              "rfi_sent_date": "2025-01-18T14:20:00.000Z",
              "last_compliance_check": "2025-01-20T16:30:45.000Z",
              "esg_breakdown": {
                "environmental": 0.6,
                "social": 0.7,
                "governance": 0.65
              },
              "compliance_issues": [
                "Missing ISO 14001 certification",
                "No public sustainability report"
              ],
              "certifications": []
            }
          ]
        }
      ],
      "response_mappings": {
        "sources": [
          {
            "id": "3190e39c-d9d7-4eeb-95af-8be16f877044",
