            "path": [
              "request_id"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://api.crunchbase.com/v4/searches/organizations",
        "method": "POST",
        "headers": {
          "Content_Type": "application/json",
          "X_cb_user_key": "<<$auth_key>>"
        },
        "body": {
          "query": [
            {
              "type": "query",
              "fields": [
                "name",
                "website",
                "short_description",
                "funding_total",
                "employee_count"
              ]
            }
          ],
          "limit": "<<$max_objects>>",
          "webhook_url": "<<$webhook_url>>",
          "request_id": "<<$id>>"
        }
      },
      "response_examples": [],
      "factor_variables": {
        "run_setup": {
          "path": [
            "body",
            "query"
          ],
          "example_value": {
            "filters": {
              "industry": "Technology",
              "size": "medium"
            }
          }
        },
        "webhook_url": {
          "path": [
            "body",
            "webhook_url"
          ],
          "example_value": "https://example.com/webhook"
        },
        "run_id": {
          "path": [
            "body",
            "request_id"
          ],
          "example_value": "run-12345"
        }
      }
    },
