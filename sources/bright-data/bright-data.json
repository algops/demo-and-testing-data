{
  "id": "src-bright-data",
  "name": "Brightdata Scraper",
  "description": "Advanced web scraping platform for extracting company data from various websites with proxy rotation and anti-bot protection",
  "source_type": "Integration",
  "delivery_type": "Endpoint",
  "configuration": {
    "max_concurrent_runs": 15,
    "timeout": 180,
    "max_retries": 2,
    "auth_key": null
  },
  "templates": {
    "run_request_template": "{\"url\": \"https://api.brightdata.com/datasets/company_data\", \"method\": \"POST\", \"headers\": {\"Content-Type\": \"application/json\", \"Authorization\": \"Bearer <<$auth_key>>\"}, \"body\": {\"query\": \"<<$run_setup>>\", \"max_results\": \"<<$max_objects>>\"}}",
    "status_request_template": "{}",
    "delivery_request_template": "{}"
  },
  "setup": {
    "run_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_setup": { "path": ["body", "query"], "status": "mapped" },
          "webhook_url": { "path": ["webhook_url"], "status": "remaining" },
          "run_id": { "path": ["id"], "status": "issue" }
        },
        "response": {
          "status": {
            "path": ["status"],
            "status": "recommended",
            "status_translations": { "ready": "completed", "processing": "running", "failed": "error" }
          },
          "job_id": {
            "path": ["job_id"],
            "status": "mapped"
          }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://api.brightdata.com/datasets/company_data\", \"method\": \"POST\", \"headers\": {\"Content-Type\": \"application/json\", \"Authorization\": \"Bearer <<$auth_key>>\"}, \"body\": {\"query\": \"<<$run_setup>>\", \"max_results\": \"<<$max_objects>>\"}}"
    },
    "status_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "status": { "path": ["status"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://api.brightdata.com/jobs/<<$run_external_id>>/status\", \"method\": \"GET\", \"headers\": {\"Authorization\": \"Bearer <<$auth_key>>\"}, \"body\": {}}"
    },
    "delivery_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "data": { "path": ["data"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://api.brightdata.com/jobs/<<$run_external_id>>/results\", \"method\": \"GET\", \"headers\": {\"Authorization\": \"Bearer <<$auth_key>>\"}, \"body\": {}}"
    }
  },
