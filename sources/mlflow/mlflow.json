          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "status": { "path": ["status"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://mlflow.internal/api/v1/models/lead-scoring-v2/status\", \"method\": \"GET\", \"headers\": {\"Content-Type\": \"application/json\"}, \"body\": {}}"
    },
    "delivery_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "data": { "path": ["predictions"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://mlflow.internal/api/v1/models/lead-scoring-v2/results\", \"method\": \"GET\", \"headers\": {\"Content-Type\": \"application/json\"}, \"body\": {}}"
    }
