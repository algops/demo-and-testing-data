{
  "id": "src-document-classification-agent",
  "name": "Document Classification Agent",
  "description": "AI agent that classifies document format and evaluates readability for knowledge base preparation",
  "source_type": "Agent",
  "delivery_type": "Endpoint",
  "configuration": {
    "max_concurrent_runs": 15,
    "timeout": 150,
    "max_retries": 2,
    "auth_key": null
  },
  "templates": {
    "run_request_template": "{\"url\": \"https://doc-classifier.internal/api/classify\", \"method\": \"POST\", \"headers\": {\"Content-Type\": \"application/json\"}, \"body\": {\"documents\": \"<<$run_setup>>\", \"webhook_url\": \"<<$webhook_url>>\", \"run_id\": \"<<$id>>\"}}",
    "status_request_template": "{}",
    "delivery_request_template": "{}"
  },
  "setup": {
    "run_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_setup": { "path": ["body", "documents"], "status": "mapped" },
          "webhook_url": { "path": ["body", "webhook_url"], "status": "mapped" },
          "run_id": { "path": ["body", "run_id"], "status": "mapped" }
        },
        "response": {
          "status": {
            "path": ["status"],
            "status": "recommended",
            "status_translations": { "completed": "completed", "processing": "running", "failed": "error" }
          },
          "classification_id": {
            "path": ["classification_id"],
            "status": "mapped"
          }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://doc-classifier.internal/api/classify\", \"method\": \"POST\", \"headers\": {\"Content-Type\": \"application/json\"}, \"body\": {\"documents\": \"<<$run_setup>>\", \"webhook_url\": \"<<$webhook_url>>\", \"run_id\": \"<<$id>>\"}}"
    },
    "status_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "status": { "path": ["status"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://doc-classifier.internal/api/classifications/<<$run_external_id>>/status\", \"method\": \"GET\", \"headers\": {\"Content-Type\": \"application/json\"}, \"body\": {}}"
    },
    "delivery_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "data": { "path": ["classifications"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://doc-classifier.internal/api/classifications/<<$run_external_id>>/results\", \"method\": \"GET\", \"headers\": {\"Content-Type\": \"application/json\"}, \"body\": {}}"
    }
  },
  "metadata": {
    "owner_org_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
