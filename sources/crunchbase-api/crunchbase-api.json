  "id": "src-crunchbase-api",
  "name": "Crunchbase API",
  "description": "Comprehensive company database API providing company profiles, funding information, and business intelligence data",
  "source_type": "Integration",
  "delivery_type": "Webhook",
  "configuration": {
    "max_concurrent_runs": 20,
    "timeout": 120,
    "max_retries": 2,
    "auth_key": null
  },
  "templates": {
    "run_request_template": "{\"url\": \"https://api.crunchbase.com/v4/searches/organizations\", \"method\": \"POST\", \"headers\": {\"Content-Type\": \"application/json\", \"X-cb-user-key\": \"<<$auth_key>>\"}, \"body\": {\"query\": [{\"type\": \"query\", \"fields\": [\"name\", \"website\", \"short_description\", \"funding_total\", \"employee_count\"]}], \"limit\": \"<<$max_objects>>\", \"webhook_url\": \"<<$webhook_url>>\", \"request_id\": \"<<$id>>\"}}",
    "status_request_template": "{}",
    "delivery_request_template": "{}"
  },
  "setup": {
    "run_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_setup": { "path": ["body", "query"], "status": "mapped" },
          "webhook_url": { "path": ["body", "webhook_url"], "status": "mapped" },
          "run_id": { "path": ["body", "request_id"], "status": "mapped" }
        },
        "response": {
          "status": {
            "path": ["status"],
            "status": "recommended",
            "status_translations": { "completed": "completed", "processing": "running", "failed": "error" }
          },
          "request_id": {
            "path": ["request_id"],
            "status": "mapped"
          }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://api.crunchbase.com/v4/searches/organizations\", \"method\": \"POST\", \"headers\": {\"Content-Type\": \"application/json\", \"X-cb-user-key\": \"<<$auth_key>>\"}, \"body\": {\"query\": [{\"type\": \"query\", \"fields\": [\"name\", \"website\", \"short_description\", \"funding_total\", \"employee_count\"]}], \"limit\": \"<<$max_objects>>\", \"webhook_url\": \"<<$webhook_url>>\", \"request_id\": \"<<$id>>\"}}"
    },
    "status_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "status": { "path": ["status"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://api.crunchbase.com/v4/requests/<<$run_external_id>>/status\", \"method\": \"GET\", \"headers\": {\"X-cb-user-key\": \"<<$auth_key>>\"}, \"body\": {}}"
    },
    "delivery_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "data": { "path": ["data"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://api.crunchbase.com/v4/requests/<<$run_external_id>>/results\", \"method\": \"GET\", \"headers\": {\"X-cb-user-key\": \"<<$auth_key>>\"}, \"body\": {}}"
    }
  },
