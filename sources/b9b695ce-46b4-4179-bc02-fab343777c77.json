{
  "id": "b9b695ce-46b4-4179-bc02-fab343777c77",
  "name": "LinkedIn People Dataset",
  "description": "Comprehensive dataset of professional profiles from LinkedIn, including contact information, job roles, skills, and experience data",
  "source_type": "dataset",
  "delivery_type": "endpoint",
  "setup": {
    "customization_permissions": {
      "factor_creation": "creator_only"
    },
    "load_balancing": {
      "concurrency": 50,
      "timeout": 60
    },
    "processing_options": {
      "input_processing": "ignore"
    },
    "run_request": {
      "mappings": {
        "request": {
          "run_setup": {
            "path": [
              "query",
              "filters"
            ],
            "mapping_status": "mapped"
          },
          "webhook_url": {
            "path": [],
            "mapping_status": "remaining"
          },
          "run_id": {
            "path": [
              "id"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "mapped"
          },
          "search_id": {
            "path": [
              "search_id"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://api.linkedin.com/v2/people/search",
        "method": "GET",
        "headers": {
          "Content-Type": "application/json",
          "Authorization": "Bearer <<$api_key>>"
        },
        "body": {}
      },
      "response_examples": [],
      "factor_variables": {
        "run_setup": {
          "path": [
            "query",
            "filters"
          ],
          "example_value": {
            "industry": "Technology",
            "role_level": "senior",
            "location": "United States"
          }
        }
      }
    },
    "status_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://api.linkedin.com/v2/searches/<<$run_external_id>>/status",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer <<$api_key>>"
        },
        "body": {}
      },
      "response_examples": []
    },
    "delivery_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "data": {
            "path": [
              "people"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://api.linkedin.com/v2/searches/<<$run_external_id>>/results",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer <<$api_key>>"
        },
        "body": {}
      },
      "response_examples": [
        {
          "status": "ready",
          "search_id": "linkedin-search-12345",
          "people": [
            {
              "id": "person-001",
              "name": "John Smith",
              "email": "john.smith@techcorp.com",
              "phone": "+1-555-0101",
              "role": "VP of Engineering",
              "department": "Engineering",
              "company": {
                "id": "comp-001",
                "name": "TechCorp Inc"
              },
              "linkedin": "https://linkedin.com/in/johnsmith",
              "skills": [
                "Python",
                "React",
                "AWS",
                "Leadership"
              ],
              "experience_years": 12,
              "specialization": "Cloud Infrastructure"
            }
          ]
        }
      ],
      "response_mappings": {}
    }
  }
}







