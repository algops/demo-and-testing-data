{
  "id": "src-trustsoft-it-agent",
  "name": "Trustsoft IT Agent",
  "description": "IT compliance evaluation agent that analyzes merge requests for security, code quality, and compliance standards",
  "source_type": "Agent",
  "delivery_type": "Endpoint",
  "configuration": {
    "max_concurrent_runs": 10,
    "timeout": 180,
    "max_retries": 2,
    "auth_key": null
  },
  "templates": {
    "run_request_template": "{\"url\": \"https://trustsoft.internal/api/v1/evaluate\", \"method\": \"POST\", \"headers\": {\"Content-Type\": \"application/json\", \"X-API-Key\": \"<<$auth_key>>\"}, \"body\": {\"merge_requests\": \"<<$run_setup>>\", \"webhook_url\": \"<<$webhook_url>>\", \"run_id\": \"<<$id>>\"}}",
    "status_request_template": "{}",
    "delivery_request_template": "{}"
  },
  "setup": {
    "run_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_setup": { "path": ["body", "merge_requests"], "status": "mapped" },
          "webhook_url": { "path": ["body", "webhook_url"], "status": "mapped" },
          "run_id": { "path": ["body", "run_id"], "status": "mapped" }
        },
        "response": {
          "status": {
            "path": ["status"],
            "status": "recommended",
            "status_translations": { "completed": "completed", "processing": "running", "failed": "error" }
          },
          "evaluation_id": {
            "path": ["evaluation_id"],
            "status": "mapped"
          }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://trustsoft.internal/api/v1/evaluate\", \"method\": \"POST\", \"headers\": {\"Content-Type\": \"application/json\", \"X-API-Key\": \"<<$auth_key>>\"}, \"body\": {\"merge_requests\": \"<<$run_setup>>\", \"webhook_url\": \"<<$webhook_url>>\", \"run_id\": \"<<$id>>\"}}"
    },
    "status_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "status": { "path": ["status"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://trustsoft.internal/api/v1/evaluations/<<$run_external_id>>/status\", \"method\": \"GET\", \"headers\": {\"X-API-Key\": \"<<$auth_key>>\"}, \"body\": {}}"
    },
    "delivery_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "data": { "path": ["evaluations"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://trustsoft.internal/api/v1/evaluations/<<$run_external_id>>/results\", \"method\": \"GET\", \"headers\": {\"X-API-Key\": \"<<$auth_key>>\"}, \"body\": {}}"
    }
  },
  "metadata": {
    "owner_org_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "owner_org_name": "AlgOps Data Solutions",
    "created_at": "2025-01-12T14:20:00.000Z",
    "updated_at": "2025-01-20T11:20:15.000Z",
    "last_used_at": "2025-01-20T11:20:15.000Z",
    "average_run_duration": 135,
    "total_runs": 200,
    "successful_runs": 180,
    "failed_runs": 20,
    "success_rate": 0.9,
