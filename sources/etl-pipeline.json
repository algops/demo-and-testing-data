{
  "id": "a14b40b6-2354-402b-ae4d-81453d26b5c4",
  "name": "ETL Pipeline",
  "description": "Extract, Transform, Load pipeline for extracting person and contact information from various data sources",
  "source_type": "Integration",
  "delivery_type": "Endpoint",
  "setup": {
    "run_request": {
      "mappings": {
        "request": {
          "run_setup": {
            "path": [
              "body",
              "filters"
            ],
            "mapping_status": "mapped"
          },
          "webhook_url": {
            "path": [
              "webhook_url"
            ],
            "mapping_status": "remaining"
          },
          "run_id": {
            "path": [
              "id"
            ],
            "mapping_status": "issue"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "recommended",
            "status_translations": {
              "ready": "completed",
              "processing": "running",
              "failed": "error"
            }
          },
          "extraction_id": {
            "path": [
              "extraction_id"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://etl-pipeline.internal/api/v1/extract",
        "method": "POST",
        "headers": {
          "Content_Type": "application/json",
          "X_API_Key": "<<$auth_key>>"
        },
        "body": {
          "source": "supplier_contacts",
          "filters": "<<$run_setup>>",
          "max_results": "<<$max_objects>>"
        }
      },
      "response_examples": [],
      "factor_variables": {
        "run_setup": {
          "path": [
            "body",
            "filters"
          ],
          "example_value": {
            "filters": {
              "industry": "Technology",
              "size": "medium"
            }
          }
        },
        "webhook_url": {
          "path": [
            "webhook_url"
          ],
          "example_value": "https://example.com/webhook"
        },
        "run_id": {
          "path": [
            "id"
          ],
          "example_value": "run-12345"
        }
      }
    },
    "status_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://etl-pipeline.internal/api/v1/extractions/<<$run_external_id>>/status",
        "method": "GET",
        "headers": {
          "X_API_Key": "<<$auth_key>>"
        },
        "body": {}
      },
      "response_examples": []
    },
    "delivery_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "data": {
            "path": [
              "contacts"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://etl-pipeline.internal/api/v1/extractions/<<$run_external_id>>/results",
        "method": "GET",
        "headers": {
          "X_API_Key": "<<$auth_key>>"
        },
        "body": {}
      },
