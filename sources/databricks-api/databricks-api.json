{
  "id": "src-databricks-api",
  "name": "Databricks Documents API",
  "description": "API for accessing compliance documents stored in Databricks data lake, providing document metadata and content",
  "source_type": "Integration",
  "delivery_type": "Endpoint",
  "configuration": {
    "max_concurrent_runs": 25,
    "timeout": 150,
    "max_retries": 2,
    "auth_key": null
  },
  "templates": {
    "run_request_template": "{\"url\": \"https://databricks-api.internal/api/2.0/workspace/documents\", \"method\": \"GET\", \"headers\": {\"Authorization\": \"Bearer <<$auth_key>>\"}, \"body\": {\"path\": \"/suppliers/compliance\", \"filters\": \"<<$run_setup>>\", \"max_results\": \"<<$max_objects>>\"}}",
    "status_request_template": "{}",
    "delivery_request_template": "{}"
  },
  "setup": {
    "run_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_setup": { "path": ["body", "filters"], "status": "mapped" },
          "webhook_url": { "path": ["webhook_url"], "status": "remaining" },
          "run_id": { "path": ["id"], "status": "issue" }
        },
        "response": {
          "status": {
            "path": ["status"],
            "status": "recommended",
            "status_translations": { "ready": "completed", "processing": "running", "failed": "error" }
          },
          "query_id": {
            "path": ["query_id"],
            "status": "mapped"
          }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://databricks-api.internal/api/2.0/workspace/documents\", \"method\": \"GET\", \"headers\": {\"Authorization\": \"Bearer <<$auth_key>>\"}, \"body\": {\"path\": \"/suppliers/compliance\", \"filters\": \"<<$run_setup>>\", \"max_results\": \"<<$max_objects>>\"}}"
    },
    "status_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "status": { "path": ["status"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://databricks-api.internal/api/2.0/queries/<<$run_external_id>>/status\", \"method\": \"GET\", \"headers\": {\"Authorization\": \"Bearer <<$auth_key>>\"}, \"body\": {}}"
    },
    "delivery_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "data": { "path": ["documents"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://databricks-api.internal/api/2.0/queries/<<$run_external_id>>/results\", \"method\": \"GET\", \"headers\": {\"Authorization\": \"Bearer <<$auth_key>>\"}, \"body\": {}}"
    }
  },
