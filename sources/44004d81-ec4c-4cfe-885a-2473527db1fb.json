{
  "id": "44004d81-ec4c-4cfe-885a-2473527db1fb",
  "name": "Document Storage API",
  "description": "API for accessing unstructured documents from various storage systems for knowledge base creation",
  "source_type": "integration",
  "delivery_type": "endpoint",
  "setup": {
    "customization_permissions": {
      "factor_creation": "creator_only"
    },
    "load_balancing": {
      "concurrency": 10,
      "timeout": 30
    },
    "processing_options": {
      "input_processing": "ignore"
    },
    "run_request": {
      "mappings": {
        "request": {
          "run_setup": {
            "path": [
              "body",
              "filters"
            ],
            "mapping_status": "mapped"
          },
          "webhook_url": {
            "path": [
              "webhook_url"
            ],
            "mapping_status": "remaining"
          },
          "run_id": {
            "path": [
              "id"
            ],
            "mapping_status": "issue"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "recommended",
            "status_translations": {
              "ready": "completed",
              "processing": "running",
              "failed": "error"
            }
          },
          "query_id": {
            "path": [
              "query_id"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://doc-storage.internal/api/v1/documents",
        "method": "GET",
        "headers": {
          "Content_Type": "application/json",
          "Authorization": "Bearer <<$auth_key>>"
        },
        "body": {
          "source": "knowledge_base",
          "filters": "<<$run_setup>>",
          "max_results": "<<$max_objects>>"
        }
      },
      "response_examples": [],
      "factor_variables": {
        "run_setup": {
          "path": [
            "body",
            "filters"
          ],
          "example_value": {
            "filters": {
              "industry": "Technology",
              "size": "medium"
            }
          }
        },
        "webhook_url": {
          "path": [
            "webhook_url"
          ],
          "example_value": "https://example.com/webhook"
        },
        "run_id": {
          "path": [
            "id"
          ],
          "example_value": "run-12345"
        }
      }
    },
    "status_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://doc-storage.internal/api/v1/queries/<<$run_external_id>>/status",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer <<$auth_key>>"
        },
        "body": {}
      },
      "response_examples": []
    },
    "delivery_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "data": {
            "path": [
              "documents"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://doc-storage.internal/api/v1/queries/<<$run_external_id>>/results",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer <<$auth_key>>"
        },
        "body": {}
      },
      "response_examples": [
