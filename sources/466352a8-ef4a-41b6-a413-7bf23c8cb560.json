{
  "id": "466352a8-ef4a-41b6-a413-7bf23c8cb560",
  "name": "Enrichment Agent",
  "description": "AI-powered agent that enriches company data with additional attributes including revenue, funding, and technology stack information",
  "source_type": "agent",
  "delivery_type": "webhook",
  "setup": {
    "customization_permissions": {
      "factor_creation": "creator_only"
    },
    "load_balancing": {
      "concurrency": 10,
      "timeout": 30
    },
    "processing_options": {
      "input_processing": "ignore"
    },
    "run_request": {
      "mappings": {
        "request": {
          "run_setup": {
            "path": [
              "body",
              "companies"
            ],
            "mapping_status": "mapped"
          },
          "webhook_url": {
            "path": [
              "body",
              "webhook_url"
            ],
            "mapping_status": "mapped"
          },
          "run_id": {
            "path": [
              "body",
              "run_id"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "recommended",
            "status_translations": {
              "completed": "completed",
              "processing": "running",
              "failed": "error"
            }
          },
          "task_id": {
            "path": [
              "task_id"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://enrichment-agent.internal/api/enrich",
        "method": "POST",
        "headers": {
          "Content_Type": "application/json"
        },
        "body": {
          "companies": "<<$run_setup>>",
          "webhook_url": "<<$webhook_url>>",
          "run_id": "<<$id>>"
        }
      },
      "response_examples": [],
      "factor_variables": {
        "run_setup": {
          "path": [
            "body",
            "companies"
          ],
          "example_value": {
            "filters": {
              "industry": "Technology",
              "size": "medium"
            }
          }
        },
        "webhook_url": {
          "path": [
            "body",
            "webhook_url"
          ],
          "example_value": "https://example.com/webhook"
        },
        "run_id": {
          "path": [
            "body",
            "run_id"
          ],
          "example_value": "run-12345"
        }
      }
    },
    "status_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://enrichment-agent.internal/api/tasks/<<$run_external_id>>/status",
        "method": "GET",
        "headers": {
          "Content_Type": "application/json"
        },
        "body": {}
      },
      "response_examples": []
    },
    "delivery_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "data": {
            "path": [
              "enriched_companies"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://enrichment-agent.internal/api/tasks/<<$run_external_id>>/results",
        "method": "GET",
        "headers": {
          "Content_Type": "application/json"
        },
        "body": {}
