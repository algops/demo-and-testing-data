{
  "id": "a276d56d-9fce-4a4a-b932-39c51b7d1132",
  "name": "Brightdata Scraper",
  "description": "Advanced web scraping platform for extracting company data from various websites with proxy rotation and anti-bot protection",
  "source_type": "integration",
  "delivery_type": "endpoint",
  "setup": {
    "customization_permissions": {
      "factor_creation": "creator_only"
    },
    "load_balancing": {
      "concurrency": 10,
      "timeout": 30
    },
    "processing_options": {
      "input_processing": "ignore"
    },
    "run_request": {
      "mappings": {
        "request": {
          "run_setup": {
            "path": [
              "body",
              "query"
            ],
            "mapping_status": "mapped"
          },
          "webhook_url": {
            "path": [
              "webhook_url"
            ],
            "mapping_status": "remaining"
          },
          "run_id": {
            "path": [
              "id"
            ],
            "mapping_status": "issue"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "recommended",
            "status_translations": {
              "ready": "completed",
              "processing": "running",
              "failed": "error"
            }
          },
          "job_id": {
            "path": [
              "job_id"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://api.brightdata.com/datasets/company_data",
        "method": "POST",
        "headers": {
          "Content_Type": "application/json",
          "Authorization": "Bearer <<$auth_key>>"
        },
        "body": {
          "query": "<<$run_setup>>",
          "max_results": "<<$max_objects>>"
        }
      },
      "response_examples": [],
      "factor_variables": {
        "run_setup": {
          "path": [
            "body",
            "query"
          ],
          "example_value": {
            "filters": {
              "industry": "Technology",
              "size": "medium"
            }
          }
        },
        "webhook_url": {
          "path": [
            "webhook_url"
          ],
          "example_value": "https://example.com/webhook"
        },
        "run_id": {
          "path": [
            "id"
          ],
          "example_value": "run-12345"
        }
      }
    },
    "status_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://api.brightdata.com/jobs/<<$run_external_id>>/status",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer <<$auth_key>>"
        },
        "body": {}
      },
      "response_examples": []
    },
    "delivery_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "data": {
            "path": [
              "data"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://api.brightdata.com/jobs/<<$run_external_id>>/results",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer <<$auth_key>>"
        },
        "body": {}
      },
      "response_examples": [
        {
