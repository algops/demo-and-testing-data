{
  "id": "0989e548-7bfa-43f5-ad4a-68e0b2be4257",
  "name": "ETL Documents API",
  "description": "API for accessing quality rule documents from ETL pipeline, providing structured quality guidelines and compliance rules",
  "source_type": "integration",
  "delivery_type": "endpoint",
  "setup": {
    "customization_permissions": {
      "factor_creation": "creator_only"
    },
    "load_balancing": {
      "concurrency": 10,
      "timeout": 30
    },
    "processing_options": {
      "input_processing": "ignore"
    },
    "run_request": {
      "mappings": {
        "request": {
          "run_setup": {
            "path": [
              "body",
              "filters"
            ],
            "mapping_status": "mapped"
          },
          "webhook_url": {
            "path": [
              "webhook_url"
            ],
            "mapping_status": "remaining"
          },
          "run_id": {
            "path": [
              "id"
            ],
            "mapping_status": "issue"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "recommended",
            "status_translations": {
              "ready": "completed",
              "processing": "running",
              "failed": "error"
            }
          },
          "query_id": {
            "path": [
              "query_id"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://etl-docs.internal/api/v1/documents",
        "method": "GET",
        "headers": {
          "Content_Type": "application/json",
          "X_API_Key": "<<$auth_key>>"
        },
        "body": {
          "category": "quality_rules",
          "filters": "<<$run_setup>>",
          "limit": "<<$max_objects>>"
        }
      },
      "response_examples": [],
      "factor_variables": {
        "run_setup": {
          "path": [
            "body",
            "filters"
          ],
          "example_value": {
            "filters": {
              "industry": "Technology",
              "size": "medium"
            }
          }
        },
        "webhook_url": {
          "path": [
            "webhook_url"
          ],
          "example_value": "https://example.com/webhook"
        },
        "run_id": {
          "path": [
            "id"
          ],
          "example_value": "run-12345"
        }
      }
    },
    "status_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://etl-docs.internal/api/v1/queries/<<$run_external_id>>/status",
        "method": "GET",
        "headers": {
          "X_API_Key": "<<$auth_key>>"
        },
        "body": {}
      },
      "response_examples": []
    },
    "delivery_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "data": {
            "path": [
              "documents"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://etl-docs.internal/api/v1/queries/<<$run_external_id>>/results",
        "method": "GET",
        "headers": {
          "X_API_Key": "<<$auth_key>>"
        },
        "body": {}
      },
      "response_examples": [
