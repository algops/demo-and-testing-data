{
  "id": "df7d17d7-ba74-4172-aa40-e003add5e102",
  "name": "GitHub API",
  "description": "GitHub REST API for accessing merge requests, commit messages, diffs, and repository information",
  "source_type": "Integration",
  "delivery_type": "Webhook",
  "setup": {
    "customization_permissions": {
      "factor_creation": "creator_only"
    },
    "load_balancing": {
      "concurrency": 10,
      "timeout": 30
    },
    "processing_options": {
      "input_processing": "ignore"
    },
    "run_request": {
      "mappings": {
        "request": {
          "run_setup": {
            "path": [
              "body",
              "filters"
            ],
            "mapping_status": "mapped"
          },
          "webhook_url": {
            "path": [
              "webhook_url"
            ],
            "mapping_status": "remaining"
          },
          "run_id": {
            "path": [
              "id"
            ],
            "mapping_status": "issue"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "recommended",
            "status_translations": {
              "ready": "completed",
              "processing": "running",
              "failed": "error"
            }
          },
          "request_id": {
            "path": [
              "request_id"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://api.github.com/repos/<<$repo>>/pulls",
        "method": "GET",
        "headers": {
          "Accept": "application/vnd.github.v3+json",
          "Authorization": "token <<$auth_key>>"
        },
        "body": {
          "state": "open",
          "filters": "<<$run_setup>>",
          "per_page": "<<$max_objects>>"
        }
      },
      "response_examples": [],
      "factor_variables": {
        "run_setup": {
          "path": [
            "body",
            "filters"
          ],
          "example_value": {
            "filters": {
              "industry": "Technology",
              "size": "medium"
            }
          }
        },
        "webhook_url": {
          "path": [
            "webhook_url"
          ],
          "example_value": "https://example.com/webhook"
        },
        "run_id": {
          "path": [
            "id"
          ],
          "example_value": "run-12345"
        }
      }
    },
    "status_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://api.github.com/repos/<<$repo>>/pulls/<<$run_external_id>>",
        "method": "GET",
        "headers": {
          "Authorization": "token <<$auth_key>>"
        },
        "body": {}
      },
      "response_examples": []
    },
    "delivery_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
