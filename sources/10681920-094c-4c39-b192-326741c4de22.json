{
  "id": "10681920-094c-4c39-b192-326741c4de22",
  "name": "Databricks Documents API",
  "description": "API for accessing compliance documents stored in Databricks data lake, providing document metadata and content",
  "source_type": "Integration",
  "delivery_type": "Endpoint",
  "setup": {
    "customization_permissions": {
      "factor_creation": "creator_only"
    },
    "load_balancing": {
      "concurrency": 10,
      "timeout": 30
    },
    "processing_options": {
      "input_processing": "ignore"
    },
    "run_request": {
      "mappings": {
        "request": {
          "run_setup": {
            "path": [
              "body",
              "filters"
            ],
            "mapping_status": "mapped"
          },
          "webhook_url": {
            "path": [
              "webhook_url"
            ],
            "mapping_status": "remaining"
          },
          "run_id": {
            "path": [
              "id"
            ],
            "mapping_status": "issue"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "recommended",
            "status_translations": {
              "ready": "completed",
              "processing": "running",
              "failed": "error"
            }
          },
          "query_id": {
            "path": [
              "query_id"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://databricks-api.internal/api/2.0/workspace/documents",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer <<$auth_key>>"
        },
        "body": {
          "path": "/suppliers/compliance",
          "filters": "<<$run_setup>>",
          "max_results": "<<$max_objects>>"
        }
      },
      "response_examples": [],
      "factor_variables": {
        "run_setup": {
          "path": [
            "body",
            "filters"
          ],
          "example_value": {
            "filters": {
              "industry": "Technology",
              "size": "medium"
            }
          }
        },
        "webhook_url": {
          "path": [
            "webhook_url"
          ],
          "example_value": "https://example.com/webhook"
        },
        "run_id": {
          "path": [
            "id"
          ],
          "example_value": "run-12345"
        }
      }
    },
    "status_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://databricks-api.internal/api/2.0/queries/<<$run_external_id>>/status",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer <<$auth_key>>"
        },
        "body": {}
      },
      "response_examples": []
    },
    "delivery_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "data": {
            "path": [
              "documents"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://databricks-api.internal/api/2.0/queries/<<$run_external_id>>/results",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer <<$auth_key>>"
        },
        "body": {}
      },
      "response_examples": [
        {
          "status": "ready",
          "query_id": "db-query-67890",
          "documents": [
            {
              "id": "doc-001",
              "title": "Supplier Compliance Policy 2024",
              "content": "This document outlines the compliance requirements for all suppliers including ESG standards, data privacy regulations, and quality assurance protocols...",
              "file_type": "pdf",
              "file_size": 245760,
              "author": "Compliance Team",
              "created_date": "2024-01-15T10:00:00.000Z",
              "modified_date": "2024-12-10T14:30:00.000Z",
              "source_system": "databricks",
              "compliance_category": "ESG",
              "metadata": {
                "supplier_id": "supp-001",
                "document_version": "2.1",
                "classification": "policy"
              }
            },
            {
              "id": "doc-002",
              "title": "RFI Template - Environmental Standards",
              "content": "Request for Information template for supplier environmental compliance assessment...",
              "file_type": "docx",
              "file_size": 128000,
              "author": "Procurement Department",
              "created_date": "2024-03-20T09:15:00.000Z",
              "modified_date": "2024-11-05T16:45:00.000Z",
              "source_system": "databricks",
              "compliance_category": "Environmental",
              "metadata": {
                "supplier_id": "supp-002",
                "document_version": "1.3",
                "classification": "template"
              }
            }
          ]
        }
      ],
