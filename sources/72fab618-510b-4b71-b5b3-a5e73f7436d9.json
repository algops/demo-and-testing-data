{
  "id": "72fab618-510b-4b71-b5b3-a5e73f7436d9",
  "name": "MLFlow Lead Scoring Model",
  "description": "Machine learning model for lead scoring deployed via MLFlow, providing lead quality scores and nurturing priorities",
  "source_type": "ML model",
  "delivery_type": "Sync",
  "setup": {
    "customization_permissions": {
      "factor_creation": "creator_only"
    },
    "load_balancing": {
      "concurrency": 10,
      "timeout": 30
    },
    "processing_options": {
      "input_processing": "ignore"
    },
    "run_request": {
      "mappings": {
        "request": {
          "run_setup": {
            "path": [
              "body",
              "inputs"
            ],
            "mapping_status": "mapped"
          },
          "webhook_url": {
            "path": [
              "webhook_url"
            ],
            "mapping_status": "remaining"
          },
          "run_id": {
            "path": [
              "id"
            ],
            "mapping_status": "issue"
          }
        },
        "response": {
          "predictions": {
            "path": [
              "predictions"
            ],
            "mapping_status": "mapped"
          },
          "status": {
            "path": [],
            "mapping_status": "remaining"
          }
        }
      },
      "request_template": {
        "url": "https://mlflow.internal/api/v1/models/lead-scoring-v2/invocations",
        "method": "POST",
        "headers": {
          "Content_Type": "application/json"
        },
        "body": {
          "inputs": "<<$run_setup>>"
        }
      },
      "response_examples": [],
      "factor_variables": {
        "run_setup": {
          "path": [
            "body",
            "inputs"
          ],
          "example_value": {
            "filters": {
              "industry": "Technology",
              "size": "medium"
            }
          }
        },
        "webhook_url": {
          "path": [
            "webhook_url"
          ],
          "example_value": "https://example.com/webhook"
        },
        "run_id": {
          "path": [
            "id"
          ],
          "example_value": "run-12345"
        }
      }
    },
    "status_request": {
      "mappings": {
        "request": {
          "run_external_id": {
            "path": [
              "url"
            ],
            "mapping_status": "mapped"
          }
        },
        "response": {
          "status": {
            "path": [
              "status"
            ],
            "mapping_status": "mapped"
          }
        }
      },
      "request_template": {
        "url": "https://mlflow.internal/api/v1/models/lead-scoring-v2/status",
