{
  "id": "src-rag-agent-guardrails",
  "name": "RAG Agent with Guardrails",
  "description": "RAG Agent configured with format validation guardrails for creating structured knowledge base entries",
  "source_type": "Agent",
  "delivery_type": "Endpoint",
  "configuration": {
    "max_concurrent_runs": 8,
    "timeout": 300,
    "max_retries": 2,
    "auth_key": null
  },
  "templates": {
    "run_request_template": "{\"url\": \"https://rag-agent-guardrails.internal/api/process\", \"method\": \"POST\", \"headers\": {\"Content-Type\": \"application/json\"}, \"body\": {\"documents\": \"<<$run_setup>>\", \"task\": \"create_structured_rules\", \"guardrails\": {\"format_validation\": true}, \"webhook_url\": \"<<$webhook_url>>\", \"run_id\": \"<<$id>>\"}}",
    "status_request_template": "{}",
    "delivery_request_template": "{}"
  },
  "setup": {
    "run_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_setup": { "path": ["body", "documents"], "status": "mapped" },
          "webhook_url": { "path": ["body", "webhook_url"], "status": "mapped" },
          "run_id": { "path": ["body", "run_id"], "status": "mapped" }
        },
        "response": {
          "status": {
            "path": ["status"],
            "status": "recommended",
            "status_translations": { "completed": "completed", "processing": "running", "failed": "error" }
          },
          "task_id": {
            "path": ["task_id"],
            "status": "mapped"
          }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://rag-agent-guardrails.internal/api/process\", \"method\": \"POST\", \"headers\": {\"Content-Type\": \"application/json\"}, \"body\": {\"documents\": \"<<$run_setup>>\", \"task\": \"create_structured_rules\", \"guardrails\": {\"format_validation\": true}, \"webhook_url\": \"<<$webhook_url>>\", \"run_id\": \"<<$id>>\"}}"
    },
    "status_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "status": { "path": ["status"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://rag-agent-guardrails.internal/api/tasks/<<$run_external_id>>/status\", \"method\": \"GET\", \"headers\": {\"Content-Type\": \"application/json\"}, \"body\": {}}"
    },
    "delivery_request_template": {
      "RequestResponseMappings": {
        "request": {
          "run_external_id": { "path": ["url"], "status": "mapped" }
        },
        "response": {
          "data": { "path": ["knowledge_sources"], "status": "mapped" }
        }
      },
      "RequestBodyTemplate": "{\"url\": \"https://rag-agent-guardrails.internal/api/tasks/<<$run_external_id>>/results\", \"method\": \"GET\", \"headers\": {\"Content-Type\": \"application/json\"}, \"body\": {}}"
    }
  },
